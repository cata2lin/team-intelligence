# Secrets — NEVER commit. These live on the NAS ($NAS_ROOT/secrets), not in git.
secrets/
*.env
*.env.*
!*.env.example
*.key
*.pem
*-credentials.json
*-service-account.json

# Python (uv manages venvs per-machine; never commit one)
.venv/
venv/
__pycache__/
*.pyc
.uv/

# OS / editor
.DS_Store
.vscode/*.log
Thumbs.db

# Build / cache
node_modules/
dist/
build/
.cache/

# apps-script-deploy runtime backups (junk)
plugins/gigi/skills/apps-script-deploy/scripts/gas_backup_*.json

# CS mirror (gigi:richpanel-export) — stare de rulare si chei, NU cod.
# push_log.json  = jurnalul de semnaturi al `rp.py push` (se reface singur).
# connector_keys.json = cheile Custom Connector. Sunt publice (stau in sursa fiecarui
#   magazin), DAR sunt credentiale de SCRIERE in fisa clientului: connectorul n-are alta
#   autentificare. Se re-culeg in cateva secunde cu `uv run rp.py keys --refresh`.
plugins/gigi/skills/richpanel-export/push_log.json
plugins/gigi/skills/richpanel-export/connector_keys.json
*.bak
# ⚠️ `*.bak` NU acoperă `*.bak2` / `*.bak3`. Măsurat 15-sep-2026: 5 copii de siguranță
# (cs_auto_draft.py.bak2/.bak3, cs_photo.py.bak2/.bak3, mcp_server.py.bak3 = 408 KB de cod mort)
# erau NETRACKATE și NEIGNORATE, deci intrau la `git add -A` într-un repo PUBLIC — iar
# `pii_guard.py --paths cs_auto_draft.py.bak2` le REFUZĂ (tabelă veche de telefoane, fără
# justificarea `pii-ok:` pe care o are fișierul curent).
*.bak[0-9]*
*.orig
*.rej
*~
